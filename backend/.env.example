# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LANGUAGE_CODE=de
DJANGO_TIME_ZONE=Europe/Berlin

# --- Database (PostGIS) ---------------------------------------------------
# PostGIS is required. A plain "postgres://" URL is accepted and normalised onto
# the spatial backend, but "postgis://" states the intent.
# Either set DATABASE_URL ...
DATABASE_URL=postgis://openvacant:openvacant@127.0.0.1:5432/openvacant
# ... or the individual DB_* variables (used only if DATABASE_URL is empty).
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=openvacant
DB_USER=openvacant
DB_PASSWORD=openvacant
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# GeoDjango finds GEOS/GDAL automatically on Linux. On macOS point these at the
# Homebrew libraries, e.g. /opt/homebrew/lib/libgeos_c.dylib.
GEOS_LIBRARY_PATH=
GDAL_LIBRARY_PATH=

# --- Cache / Redis --------------------------------------------------------
USE_REDIS_CACHE=False
REDIS_URL=redis://127.0.0.1:6379/0

# --- Email ----------------------------------------------------------------
# Dev default is Mailpit (smtp). Use console backend if you prefer.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@example.com

# --- CORS -----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# --- Auth / allauth -------------------------------------------------------
DJANGO_SITE_ID=1
# Separate senders protect transactional deliverability (fall back to DEFAULT_FROM_EMAIL).
TRANSACTIONAL_FROM_EMAIL=
MARKETING_FROM_EMAIL=

# Social login: a provider only appears once BOTH its CLIENT_ID and SECRET are set.
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_SECRET=
# Apple additionally needs the key id, team id (key) and the .p8 certificate contents.
APPLE_CLIENT_ID=
APPLE_SECRET=
APPLE_KEY_ID=
APPLE_CERTIFICATE_KEY=

# --- Billing (Stripe) -----------------------------------------------------
# Leave empty to disable billing entirely (UI degrades gracefully).
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=False
# Recurring price ids from the Stripe dashboard:
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# --- Object storage (Phase 6) ---------------------------------------------
# Set USE_S3=True to store uploads on an S3-compatible bucket (R2, B2, Hetzner, AWS).
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=False

# --- Search ---------------------------------------------------------------
# "database" (Postgres FTS, default) or "elasticsearch".
SEARCH_BACKEND=database
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=documents

# --- Compliance & analytics (Phase 7) -------------------------------------
ACCOUNT_DELETION_GRACE_DAYS=30
# ANALYTICS_PROVIDER: empty, "plausible" or "matomo"
ANALYTICS_PROVIDER=
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SRC=https://plausible.io/js/script.js
MATOMO_URL=
MATOMO_SITE_ID=

# --- Error tracking (Sentry, Phase 10) ------------------------------------
# Leave SENTRY_DSN empty to disable Sentry entirely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Production-only security toggles (ignored when DJANGO_DEBUG=True) -----
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Maps -----------------------------------------------------------------
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
# Fallback map centre (Reichenbach im Vogtland); each municipality can override it.
MAP_DEFAULT_LATITUDE=50.6236
MAP_DEFAULT_LONGITUDE=12.3036
MAP_DEFAULT_ZOOM=14

# --- Geocoding ------------------------------------------------------------
# "nominatim" or "none". Nominatim's public service requires a real contact
# address in the user agent and allows about one request per second.
GEOCODER_PROVIDER=nominatim
GEOCODER_ENDPOINT=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=OpenVacant/1.0 (contact: unset)
GEOCODER_COUNTRY_CODES=de
GEOCODER_TIMEOUT=5.0

# --- Citizen reporting ----------------------------------------------------
ANONYMOUS_REPORTS_ENABLED=True
REPORT_RATE_LIMIT=5/h
REPORT_MAX_PHOTOS=5
REPORT_MAX_PHOTO_SIZE_MB=10

# --- Retention ------------------------------------------------------------
REPORT_REJECTED_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=730
