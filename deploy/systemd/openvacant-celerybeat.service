[Unit]
Description=OpenVacant - Celery beat scheduler
After=network.target redis.service postgresql.service
Requires=redis.service

[Service]
Type=simple
User=openvacant
Group=openvacant
WorkingDirectory=/opt/openvacant/backend
EnvironmentFile=/opt/openvacant/backend/.env

ExecStart=/opt/openvacant/venv/bin/celery -A core beat \
    --loglevel=info \
    --logfile=/var/log/openvacant/celerybeat.log \
    --schedule=/opt/openvacant/backend/celerybeat-schedule

Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/openvacant/backend /var/log/openvacant

[Install]
WantedBy=multi-user.target
