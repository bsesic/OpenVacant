[Unit]
Description=OpenVacant - Celery worker
Documentation=https://github.com/bsesic/OpenVacant
After=network-online.target redis-server.service postgresql.service
Requires=redis-server.service

[Service]
Type=simple
User=openvacant
Group=openvacant
WorkingDirectory=/opt/openvacant/backend
EnvironmentFile=/opt/openvacant/backend/.env

# The work is geodata imports, context recomputation, statistics snapshots and
# retention runs: few tasks, some of them long. A small pool with late
# acknowledgement suits that better than many short-lived workers.
ExecStart=/opt/openvacant/venv/bin/celery -A core worker \
    --loglevel=info \
    --concurrency=2 \
    --max-tasks-per-child=200 \
    --logfile=/var/log/openvacant/celery.log

Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
# Long enough for a layer import to finish rather than be cut off half way.
TimeoutStopSec=300

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/openvacant/backend/media /var/log/openvacant

[Install]
WantedBy=multi-user.target
