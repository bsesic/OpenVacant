[Unit]
Description=OpenVacant - Daphne ASGI server (use instead of gunicorn for WebSockets/Channels)
After=network.target postgresql.service redis.service
Wants=redis.service

[Service]
Type=simple
User=openvacant
Group=openvacant
WorkingDirectory=/opt/openvacant/backend
EnvironmentFile=/opt/openvacant/backend/.env

ExecStart=/opt/openvacant/venv/bin/daphne \
    -b 127.0.0.1 \
    -p 8000 \
    --access-log /var/log/openvacant/access.log \
    core.asgi:application

Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/openvacant/backend /var/log/openvacant

[Install]
WantedBy=multi-user.target
