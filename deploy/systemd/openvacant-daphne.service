[Unit]
Description=OpenVacant - Daphne ASGI server
Documentation=https://github.com/bsesic/OpenVacant
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target redis-server.service

# Optional. The application is templates-first and WSGI is enough for it; run
# Daphne instead of Gunicorn only if you add WebSocket features. Running both
# against the same port will not work — pick one, or give Daphne its own port
# and route /ws/ to it in NGINX.
#
#   systemctl disable --now openvacant-gunicorn
#   systemctl enable  --now openvacant-daphne

[Service]
Type=simple
User=openvacant
Group=openvacant
WorkingDirectory=/opt/openvacant/backend
EnvironmentFile=/opt/openvacant/backend/.env

ExecStart=/opt/openvacant/venv/bin/daphne \
    --bind 127.0.0.1 \
    --port 8000 \
    --proxy-headers \
    --access-log /var/log/openvacant/daphne-access.log \
    core.asgi:application

Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/openvacant/backend/media /opt/openvacant/backend/staticfiles /var/log/openvacant

[Install]
WantedBy=multi-user.target
