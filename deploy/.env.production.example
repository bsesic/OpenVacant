# Production environment for OpenVacant.
# Copy to backend/.env on the server (host deployment) or to deploy/.env.production
# (Docker deployment) and fill in real values. Never commit the real file.

# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=CHANGE-ME-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_LANGUAGE_CODE=de
DJANGO_TIME_ZONE=Europe/Berlin

# --- Database (PostGIS) ---------------------------------------------------
# PostGIS is required, not optional: geometry is a first-class field on
# properties, parcels, districts and geo layers.
#
# Host / systemd deployment: the app connects to a local Postgres and
# DATABASE_URL takes precedence over the DB_* variables.
DATABASE_URL=postgis://openvacant:CHANGE-ME@127.0.0.1:5432/openvacant

# Docker deployment: the compose file builds DATABASE_URL from these (host = the
# `db` service) and they also seed the database container on first run.
DB_NAME=openvacant
DB_USER=openvacant
DB_PASSWORD=CHANGE-ME

# Set up the database once, before the first deploy:
#   createdb openvacant
#   psql -d openvacant -c 'CREATE EXTENSION IF NOT EXISTS postgis;'

# --- Cache / Redis --------------------------------------------------------
# Redis serves as the cache (sessions, rate-limit counters, throttles) and as the
# Celery broker. Separate databases so flushing the cache cannot drop the queue.
USE_REDIS_CACHE=True
REDIS_URL=redis://127.0.0.1:6379/0

# --- Celery (background work) --------------------------------------------
# Geodata imports, spatial context recomputation, statistics snapshots and the
# retention run. Needs one worker and exactly one beat scheduler.
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- Protected file delivery ---------------------------------------------
# Uploaded files are not served from a public location: the media root holds
# expert reports, letters to owners and unreleased photographs next to released
# ones. Downloads go through views that authorise the caller and then hand the
# file to NGINX via its internal location. Keep this on behind NGINX.
USE_X_ACCEL_REDIRECT=True
PROTECTED_MEDIA_LOCATION=/protected/

# --- Email (SMTP relay: Brevo / Postmark / SES) ---------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE-ME
EMAIL_HOST_PASSWORD=CHANGE-ME
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=OpenVacant <noreply@example.com>
# Separate senders protect transactional deliverability: a bounced newsletter
# must not stop a report confirmation from arriving.
TRANSACTIONAL_FROM_EMAIL=OpenVacant <noreply@example.com>
MARKETING_FROM_EMAIL=OpenVacant <news@example.com>

# --- Geospatial libraries -------------------------------------------------
# Found automatically on Linux. Only set these if the distribution puts them
# somewhere unusual.
GEOS_LIBRARY_PATH=
GDAL_LIBRARY_PATH=

# --- Maps -----------------------------------------------------------------
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
# Fallback centre; each municipality can override it in its own settings.
MAP_DEFAULT_LATITUDE=50.6236
MAP_DEFAULT_LONGITUDE=12.3036
MAP_DEFAULT_ZOOM=14

# --- Geocoding ------------------------------------------------------------
# The public Nominatim service requires a real contact address in the user agent
# and tolerates roughly one request per second. For anything beyond occasional
# use, run your own instance or point this at a state service.
GEOCODER_PROVIDER=nominatim
GEOCODER_ENDPOINT=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=OpenVacant/1.0 (contact: it@example.com)
GEOCODER_COUNTRY_CODES=de
GEOCODER_TIMEOUT=5.0

# --- Citizen reporting ----------------------------------------------------
ANONYMOUS_REPORTS_ENABLED=True
REPORT_RATE_LIMIT=5/h
REPORT_MAX_PHOTOS=5
REPORT_MAX_PHOTO_SIZE_MB=10

# --- Retention ------------------------------------------------------------
# Applied nightly. Rejected and spam reports that never became a record are
# deleted after this many days; ones attached to a record are kept as
# provenance. The access log expires on its own schedule.
REPORT_REJECTED_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=730
ACCOUNT_DELETION_GRACE_DAYS=30

# --- Object storage (optional) -------------------------------------------
# Set USE_S3=True to keep photographs and documents on S3-compatible storage.
# AWS_QUERYSTRING_AUTH must stay True: internal documents are delivered as
# signed, short-lived URLs, and a public bucket would defeat the whole
# authorisation layer.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_QUERYSTRING_AUTH=True

# --- Analytics (privacy-friendly, optional) ------------------------------
ANALYTICS_PROVIDER=
PLAUSIBLE_DOMAIN=
MATOMO_URL=
MATOMO_SITE_ID=

# --- Error tracking (optional) -------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Billing (optional; leave empty to disable) --------------------------
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Security -------------------------------------------------------------
# Both are ignored when DJANGO_DEBUG=True. Turn the redirect off only if the
# reverse proxy in front already does it.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
